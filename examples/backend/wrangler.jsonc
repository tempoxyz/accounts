{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-10-01",
  // `process.env` holds the vars.
  "compatibility_flags": ["nodejs_compat"],
  // One object for each session ID holds the session, so its refreshes share one instance.
  "durable_objects": {
    "bindings": [{ "class_name": "SESSIONS", "name": "SESSIONS" }],
  },
  "main": "./worker.ts",
  "migrations": [{ "new_sqlite_classes": ["SESSIONS"], "tag": "v1" }],
  "name": "tempo-id-example-backend",
  // Without a registration, the app's origin is its client ID.
  "vars": {
    "APP_URL": "http://localhost:5191",
    "TEMPO_ID_URL": "http://localhost:5173",
  },
}
