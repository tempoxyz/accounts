{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The Worker serves the page's assets, so the page sends to the relay route at its own origin.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/relay"],
  },
  "compatibility_date": "2026-10-01",
  // `process.env` holds the vars.
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker.ts",
  "name": "tempo-id-example-sponsored-self-hosted",
  // Each user ID sends at most 10 requests to the relay route each minute.
  "ratelimits": [
    {
      "name": "RELAY_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  // The page's origin is its client ID, so the route accepts only that app's access tokens. Before
  // `pnpm deploy`, set `APP_URL` to the deployed origin.
  "vars": {
    "APP_URL": "http://localhost:5193",
  },
}
