{
  "name": "@tempoxyz/example-id-cli",
  "version": "0.0.2",
  "description": "Signs in to Tempo through Tempo ID's device grant.",
  "private": true,
  "type": "module",
  "bin": {
    "tempo": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tempoxyz/accounts.git",
    "directory": "playgrounds/cli"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:types": "tsc",
    "prepack": "tsc -p tsconfig.build.json",
    "start": "node --import tsx --env-file-if-exists=.env index.ts"
  },
  "dependencies": {
    "accounts": "workspace:*",
    "incur": "catalog:",
    "mppx": "catalog:",
    "ox": "catalog:",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
