{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // Node strips this playground's types as it runs it, so it accepts only erasable syntax. The
    // other playgrounds run through tsx, Vite, or Metro, and compile `@tempoxyz/id`'s source, whose
    // `machines` namespaces are values.
    "erasableSyntaxOnly": true,
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": ["*.ts"]
}
