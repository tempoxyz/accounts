{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // Node runs each playground's TypeScript as it is, so relative imports name the `.ts` file.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "jsx": "preserve",
    "types": ["node"]
  },
  "exclude": ["**/dist", "**/node_modules"]
}
