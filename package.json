{
  "scripts": {
    "build": "zile --project tsconfig.build.json",
    "changeset:publish": "pnpm publish:prepare && changeset publish && zile publish:post",
    "changeset:version": "changeset version && pnpm check",
    "check": "vp check --fix",
    "check:types": "tsc && tsc -p scripts && tsc -p test/bench && pnpm --filter './examples/*' --filter './site' --filter './test/apps/*' check:types",
    "postinstall": "zile dev",
    "publish:prepare": "zile publish:prepare --project tsconfig.build.json",
    "size": "node scripts/size.ts",
    "test": "vp test",
    "test:e2e": "playwright test",
    "waterfall": "node scripts/waterfall.ts",
    "waterfall:report": "node scripts/waterfall.ts --report"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@wagmi/core": "catalog:",
    "abort-controller": "catalog:",
    "esbuild": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-web-browser": "catalog:",
    "ioredis": "catalog:",
    "miniflare": "catalog:",
    "mppx": "catalog:",
    "prool": "catalog:",
    "react": "catalog:",
    "react-native-get-random-values": "catalog:",
    "testcontainers": "catalog:",
    "typescript": "catalog:",
    "viem": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zile": "catalog:"
  },
  "engines": {
    "node": ">=24.21"
  },
  "packageManager": "pnpm@11.19.0",
  "[!start-pkg]": "",
  "name": "accounts",
  "version": "1.0.0",
  "description": "Accounts SDK for apps on Tempo: sign users in with Tempo ID, keep their session and access key, and pay with stablecoins from browsers, React Native, Node and Workers",
  "keywords": [
    "tempo",
    "tempo-id",
    "accounts",
    "wallet",
    "authentication",
    "access-keys",
    "stablecoin",
    "payments",
    "mpp",
    "viem",
    "wagmi"
  ],
  "homepage": "https://accounts.tempo.xyz",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": [
    "./dist/*.native.js",
    "./dist/expo/index.js",
    "./dist/lite/index.native.js",
    "./dist/plugins/index.native.js",
    "./src/*.native.ts",
    "./src/expo/index.ts",
    "./src/lite/index.native.ts",
    "./src/plugins/index.native.ts"
  ],
  "exports": {
    ".": {
      "src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "react-native": {
        "types": "./dist/index.native.d.ts",
        "default": "./dist/index.native.js"
      },
      "default": "./dist/index.js"
    },
    "./index.native": {
      "src": "./src/index.native.ts",
      "types": "./dist/index.native.d.ts",
      "default": "./dist/index.native.js"
    },
    "./cloudflare": {
      "src": "./src/cloudflare/index.ts",
      "types": "./dist/cloudflare/index.d.ts",
      "default": "./dist/cloudflare/index.js"
    },
    "./expo": {
      "src": "./src/expo/index.ts",
      "types": "./dist/expo/index.d.ts",
      "default": "./dist/expo/index.js"
    },
    "./hint": {
      "src": "./src/hint/index.ts",
      "types": "./dist/hint/index.d.ts",
      "default": "./dist/hint/index.js"
    },
    "./internal": {
      "src": "./src/internal/index.ts",
      "types": "./dist/internal/index.d.ts",
      "default": "./dist/internal/index.js"
    },
    "./lite": {
      "src": "./src/lite/index.ts",
      "types": "./dist/lite/index.d.ts",
      "react-native": {
        "types": "./dist/lite/index.native.d.ts",
        "default": "./dist/lite/index.native.js"
      },
      "default": "./dist/lite/index.js"
    },
    "./lite.native": {
      "src": "./src/lite/index.native.ts",
      "types": "./dist/lite/index.native.d.ts",
      "default": "./dist/lite/index.native.js"
    },
    "./mpp": {
      "src": "./src/mpp/index.ts",
      "types": "./dist/mpp/index.d.ts",
      "default": "./dist/mpp/index.js"
    },
    "./plugins": {
      "src": "./src/plugins/index.ts",
      "types": "./dist/plugins/index.d.ts",
      "react-native": {
        "types": "./dist/plugins/index.native.d.ts",
        "default": "./dist/plugins/index.native.js"
      },
      "default": "./dist/plugins/index.js"
    },
    "./plugins.native": {
      "src": "./src/plugins/index.native.ts",
      "types": "./dist/plugins/index.native.d.ts",
      "default": "./dist/plugins/index.native.js"
    },
    "./react": {
      "src": "./src/react/index.ts",
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./test": {
      "src": "./src/test/index.ts",
      "types": "./dist/test/index.d.ts",
      "default": "./dist/test/index.js"
    },
    "./test/playwright": {
      "src": "./src/test/playwright.ts",
      "types": "./dist/test/playwright.d.ts",
      "default": "./dist/test/playwright.js"
    },
    "./wagmi": {
      "src": "./src/wagmi/index.ts",
      "types": "./dist/wagmi/index.d.ts",
      "default": "./dist/wagmi/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!**/*.test.ts",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "jose": "catalog:",
    "ox": "catalog:",
    "xstate": "catalog:"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.43",
    "@wagmi/core": "^3.6.7",
    "expo-secure-store": ">=14",
    "expo-web-browser": ">=14",
    "mppx": ">=0.19.0",
    "react": ">=18",
    "react-native-get-random-values": ">=1",
    "viem": "^2.57.20"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "@wagmi/core": {
      "optional": true
    },
    "expo-secure-store": {
      "optional": true
    },
    "expo-web-browser": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native-get-random-values": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tempoxyz/accounts.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
