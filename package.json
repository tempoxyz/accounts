{
  "scripts": {
    "build": "zile",
    "changeset:publish": "zile publish:prepare && changeset publish && zile publish:post",
    "changeset:version": "changeset version && pnpm check",
    "check": "vp lint --fix --ignore-pattern package.json && vp fmt src examples playgrounds ref-impls scripts test",
    "dev": "docker compose up -d",
    "dev:cli": "pnpm --filter './playgrounds/cli' dev",
    "docs:build": "pnpm --filter site build",
    "docs:dev": "pnpm --filter site dev",
    "docs:preview": "pnpm --filter site preview",
    "check:types": "tsc -b --noEmit && pnpm --filter './examples/*' check:types && pnpm --filter './playgrounds/web' check:types && pnpm --filter './playgrounds/cli' check:types",
    "dev:dialog": "pnpm --filter tempo-app dev",
    "dev:dialog-ref": "pnpm --filter dialog-ref dev",
    "dev:hosts": "./scripts/dev:hosts.sh",
    "dev:playground": "pnpm --filter './playgrounds/web' dev",
    "dev:react-native": "pnpm --filter react-native-playground start",
    "dev:wagmi": "pnpm --filter './playgrounds/wagmi' dev & pnpm dev:dialog",
    "examples": "node --import tsx scripts/examples.ts",
    "postinstall": "pnpm preconstruct",
    "preconstruct": "zile dev",
    "test": "vp test",
    "vp": "vp"
  },
  "packageManager": "pnpm@11.0.8",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@privy-io/react-auth": "3.25.0",
    "@remix-run/route-pattern": "^0.20.0",
    "@types/express": "^5.0.6",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/devtools": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@wagmi/core": "^3.6.0",
    "elysia": "^1.4.28",
    "expo-secure-store": "^55.0.13",
    "expo-web-browser": "^55.0.14",
    "express": "^5.2.1",
    "frog": "^1.0.15",
    "playwright-core": "^1.59.1",
    "prool": "catalog:",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "^0.35.9",
    "simple-git-hooks": "^2.13.1",
    "testcontainers": "^11.14.0",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "viem": "catalog:",
    "vp": "catalog:",
    "wagmi": "catalog:",
    "zile": "^0.0.25"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check"
  },
  "imports": {
    "#*": "./src/*"
  },
  "[!start-pkg]": "",
  "name": "accounts",
  "description": "Tempo Accounts SDK",
  "type": "module",
  "version": "0.17.1",
  "dependencies": {
    "hono": "catalog:",
    "idb-keyval": "^6.2.2",
    "jose": "^6.2.3",
    "mipd": "^0.0.7",
    "mppx": "catalog:",
    "ox": "~0.14.30",
    "wata": "0.4.0",
    "webauthx": "~0.1.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "peerDependencies": {
