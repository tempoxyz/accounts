{
  "scripts": {
    "build": "zile --project tsconfig.build.json",
    "changeset:prepublish": "zile publish:prepare --project tsconfig.build.json",
    "changeset:publish": "pnpm changeset:prepublish && changeset publish && zile publish:post",
    "changeset:version": "changeset version && pnpm check",
    "check": "vp check --fix",
    "check:types": "tsc && pnpm --filter './examples/*' check:types",
    "postinstall": "zile dev",
    "test": "vp test"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@wagmi/core": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-web-browser": "catalog:",
    "mppx": "catalog:",
    "react": "catalog:",
    "react-native-get-random-values": "catalog:",
    "typescript": "catalog:",
    "viem": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zile": "catalog:"
  },
  "engines": {
    "node": ">=24.21"
  },
  "packageManager": "pnpm@11.19.0",
  "[!start-pkg]": "",
  "name": "accounts",
  "version": "0.21.1",
  "description": "Accounts SDK for Tempo Apps",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": [
    "./dist/*.native.js",
    "./dist/expo/index.js",
    "./dist/plugins/index.native.js",
    "./src/*.native.ts",
    "./src/expo/index.ts",
    "./src/plugins/index.native.ts"
  ],
  "exports": {
    ".": {
      "src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "react-native": {
        "types": "./dist/index.native.d.ts",
        "default": "./dist/index.native.js"
      },
      "default": "./dist/index.js"
    },
    "./index.native": {
      "src": "./src/index.native.ts",
      "types": "./dist/index.native.d.ts",
      "default": "./dist/index.native.js"
    },
    "./cloudflare": {
      "src": "./src/cloudflare/index.ts",
      "types": "./dist/cloudflare/index.d.ts",
      "default": "./dist/cloudflare/index.js"
    },
    "./expo": {
      "src": "./src/expo/index.ts",
      "types": "./dist/expo/index.d.ts",
      "default": "./dist/expo/index.js"
    },
    "./internal": {
      "src": "./src/internal.ts",
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./mpp": {
      "src": "./src/mpp/index.ts",
      "types": "./dist/mpp/index.d.ts",
      "default": "./dist/mpp/index.js"
    },
    "./plugins": {
      "src": "./src/plugins/index.ts",
      "types": "./dist/plugins/index.d.ts",
      "react-native": {
        "types": "./dist/plugins/index.native.d.ts",
        "default": "./dist/plugins/index.native.js"
      },
      "default": "./dist/plugins/index.js"
    },
    "./plugins.native": {
      "src": "./src/plugins/index.native.ts",
      "types": "./dist/plugins/index.native.d.ts",
      "default": "./dist/plugins/index.native.js"
    },
    "./react": {
      "src": "./src/react/index.ts",
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./wagmi": {
      "src": "./src/wagmi/index.ts",
      "types": "./dist/wagmi/index.d.ts",
      "default": "./dist/wagmi/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!**/*.test.ts",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "jose": "catalog:",
    "ox": "catalog:",
    "xstate": "catalog:"
  },
  "peerDependencies": {
    "@wagmi/core": "^3.6.7",
    "expo-secure-store": ">=14",
    "expo-web-browser": ">=14",
    "mppx": ">=0.17.1",
    "react": ">=18",
    "react-native-get-random-values": ">=1",
    "viem": "^2.57.12"
  },
  "peerDependenciesMeta": {
    "@wagmi/core": {
      "optional": true
    },
    "expo-secure-store": {
      "optional": true
    },
    "expo-web-browser": {
      "optional": true
    },
    "mppx": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native-get-random-values": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tempoxyz/accounts.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
