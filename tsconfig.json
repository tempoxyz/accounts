{
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "module": "nodenext",
    "moduleDetection": "force",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // The package's own name resolves to `dist`, whose entries link to `src` and resolve no sibling
    // module, so each import of `accounts` outside `src` would be `any`.
    "paths": {
      "accounts": ["./src/index.ts"],
      "accounts/*": ["./src/*/index.ts"],
      "accounts/test/playwright": ["./src/test/playwright.ts"]
    },
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2024",
    // The package runs in browsers, React Native, Node, and Workers. `Store.file` loads Node's modules
    // through `process.getBuiltinModule` on first use, so only their types are global.
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  // The examples, the scripts, the site, the test apps, and the bench check their own types. The
  // scripts' configuration also checks Uphill's metric scripts.
  "exclude": [
    "**/dist",
    "**/node_modules",
    ".agents",
    ".claude",
    "examples",
    "scripts",
    "site",
    "test/apps",
    "test/bench"
  ]
}
