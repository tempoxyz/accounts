{
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "module": "nodenext",
    "moduleDetection": "force",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // The tests and `test/` import the package by its entries, which `package.json` links to their
    // source. The Tempo ID checkout's modules name its server's modules by its private package's name,
    // as its own `tsconfig.json` maps them.
    "paths": {
      "@tempoxyz/id-internal/app/*": ["./.tempo-id/src/app/*"],
      "@tempoxyz/id-internal/internal/*": ["./.tempo-id/src/internal/*"],
      "accounts": ["./src/index.ts"],
      "accounts/cloudflare": ["./src/cloudflare/index.ts"],
      "accounts/expo": ["./src/expo/index.ts"],
      "accounts/internal": ["./src/internal.ts"],
      "accounts/mpp": ["./src/mpp/index.ts"],
      "accounts/plugins": ["./src/plugins/index.ts"],
      "accounts/react": ["./src/react/index.ts"],
      "accounts/wagmi": ["./src/wagmi/index.ts"]
    },
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2024",
    // The package runs in browsers, React Native, Node, and Workers. `Store.file` imports Node's modules
    // on first use, so only their types are global.
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  // The examples and playgrounds check their own types. `scripts/publish.mjs` is the release script.
  // The tests and `test/` import the Tempo ID checkout at `.tempo-id`, which `test/id.ts` prepares.
  // `tsconfig.build.json` checks the package without it.
  "exclude": [
    "**/dist",
    "**/node_modules",
    ".claude",
    ".tempo-id",
    "examples",
    "playgrounds",
    "scripts"
  ]
}
