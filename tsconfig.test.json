{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      // The Tempo ID checkout's modules, which the suites import, name its server's modules by its
      // private package's name, as its own `tsconfig.json` maps them.
      "@tempoxyz/id-internal/app/*": ["./.tempo-id/src/app/*"],
      "@tempoxyz/id-internal/internal/*": ["./.tempo-id/src/internal/*"],
      // The tests import the package by its entries, which `package.json` links to their source.
      "accounts": ["./src/index.ts"],
      "accounts/cloudflare": ["./src/cloudflare/index.ts"],
      "accounts/expo": ["./src/expo/index.ts"],
      "accounts/internal": ["./src/internal.ts"],
      "accounts/mpp": ["./src/mpp/index.ts"],
      "accounts/plugins": ["./src/plugins/index.ts"],
      "accounts/react": ["./src/react/index.ts"],
      "accounts/wagmi": ["./src/wagmi/index.ts"]
    }
  },
  // The tests of `src/`, and `test/`, for which `test/id.ts` prepares the checkout.
  "include": ["src/**/*.test.ts", "test"],
  "exclude": ["**/dist", "**/node_modules", ".tempo-id"]
}
