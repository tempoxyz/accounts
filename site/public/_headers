# Browsers reach the production origin only over HTTPS. The tempo.com zone sets no HSTS, so this rule
# sets it for two years, without subdomains.
https://accounts.tempo.com/*
  Strict-Transport-Security: max-age=63072000

# The Cloudflare Deploy Broker uploads a file whose extension its builder does not map with no media
# type, and Cloudflare then serves it with no Content-Type. These rules set the types that Wrangler
# sends. A rule matches the path of the request, before a rewrite of `_redirects`, and a header that
# two rules set holds both values, so each path matches at most one of these rules.
/:page.md
  Content-Type: text/markdown; charset=utf-8

/docs/:group/:page.md
  Content-Type: text/markdown; charset=utf-8

/docs/:group/:topic/:page.md
  Content-Type: text/markdown; charset=utf-8

/assets/md/*
  Content-Type: text/markdown; charset=utf-8

/site.webmanifest
  Content-Type: application/manifest+json
