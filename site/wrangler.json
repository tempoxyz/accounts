{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "accounts-site",
  "account_id": "ba6ee3674b03f08481e57ff9992c601e",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/public",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "class_name": "DurableStore", "name": "DURABLE_STORE" }]
  },
  "exports": {
    "DurableStore": { "storage": "sqlite", "type": "durable-object" }
  },
  "kv_namespaces": [
    { "binding": "STORE", "id": "45b778b6db1d468a8d8b342a838fcd39" }
  ],
  "main": "./src/server/Worker.ts",
  "preview_urls": false,
  "routes": [
    { "custom_domain": true, "pattern": "accounts.tempo.com" },
    { "custom_domain": true, "pattern": "accounts.tempo.xyz" }
  ],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "workers_dev": false
}
